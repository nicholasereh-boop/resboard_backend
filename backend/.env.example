# Copy this file to .env and fill in your own values. NEVER commit .env or share it (it holds secrets).
# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL=
DJANGO_ADMIN_ENABLED=
FRONTEND_URL=http://localhost:5173
SITE_NAME=StoryBoard
SITE_CONTACT_EMAIL=
NUM_PROXIES=0
LOG_LEVEL=INFO

# Database and cache (leave the DB_* values empty to use the local SQLite file)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
REDIS_URL=

# Sign-in with Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Paystack (used by the marketplace AND the Academy)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_URL=
# Prices are shown in dollars; Paystack charges the naira equivalent
MARKETPLACE_CURRENCY=USD
MARKETPLACE_CHARGE_CURRENCY=NGN
MARKETPLACE_FX_LIVE=true
# Fallback naira-per-dollar rate, used if the live lookup fails (use today's real rate)
MARKETPLACE_FX_RATE=

# Media storage (leave empty to store uploads on this server)
MEDIA_MAX_UPLOAD_BYTES=
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_REGION=
MEDIA_STORAGE_ACCESS_KEY=
MEDIA_STORAGE_SECRET_KEY=
MEDIA_STORAGE_ENDPOINT=
MEDIA_CDN_DOMAIN=
MEDIA_UPLOAD_QUOTA_PER_HOUR=

# Comments, analytics, privacy, security
COMMENT_EDIT_WINDOW_MINUTES=
COMMENT_BLOCKED_WORDS=
ANALYTICS_ENABLED=
ANALYTICS_DEDUPE_MINUTES=
ANALYTICS_RETENTION_DAYS=
ANALYTICS_HASH_SECRET=
STAFF_SESSION_IDLE_MINUTES=
STAFF_MFA_REQUIRED=
MFA_ENCRYPTION_KEY=
AUDIT_RETENTION_DAYS=
AUDIT_HASH_SECRET=
CSP_REPORT_ONLY=
PRIVACY_CONSENT_MODE=
PRIVACY_POLICY_DATE=

# Academy (courses, lessons, progress, paid access). Set ACADEMY_ENABLED=false to switch the whole Academy off.
# ACADEMY_ENABLED=true
# ACADEMY_CURRENCY=USD
# ACADEMY_MAX_PRICE=10000
# ACADEMY_DEFAULT_COMPLETION_THRESHOLD=90
# ACADEMY_PROGRESS_UPDATE_INTERVAL_SECONDS=15
# ACADEMY_COMMENT_GATE_DEFAULT=true
# ACADEMY_COMMENT_MODERATION=false

# News (sources, rights, newsroom, comments). All off or safe by default. NEWS_ENABLED=false switches the whole section off.
# NEWS_ENABLED=true
# NEWS_PUBLIC_ENABLED=false
# NEWS_IMPORT_ENABLED=false
# NEWS_COMMENTS_ENABLED=false
# NEWS_COMMENT_MODERATION=false
# NEWS_REQUIRE_COMMERCIAL_RIGHTS=true
# NEWS_PUBLIC_CACHE_SECONDS=60
# NEWS_COPYRIGHT_CONTACT=copyright@example.com
# NEWS_TAKEDOWN_NOTIFY_EMAIL=editors@example.com
# NEWS_RIGHTS_WARNING_DAYS=14
